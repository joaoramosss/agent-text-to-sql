# Copie para .env e preencha. O .env nunca é commitado.

# Provedor de LLM: groq | openrouter
LLM_PROVIDER=groq

# Modelo (nome como o provedor espera)
#   groq:       openai/gpt-oss-120b | qwen/qwen3.8-27b | openai/gpt-oss-20b
#   openrouter: ex. openai/gpt-oss-120b:free
LLM_MODEL=openai/gpt-oss-120b

# Chaves — crie em https://console.groq.com/keys e https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Banco DuckDB gerado por scripts/load_data.py (padrão: data/olist.duckdb)
DB_PATH=

# Limites do agente (opcionais; vazio = padrão)
# Máximo de linhas devolvidas por consulta (padrão: 1000)
SQL_MAX_ROWS=
# Tempo máximo de uma consulta, em segundos (padrão: 10)
SQL_TIMEOUT_SECONDS=
# Tentativas de gerar SQL: 1 + correções após erro (padrão: 3)
AGENT_MAX_ATTEMPTS=

# Traces (um JSON por pergunta). Padrão: logs/traces.jsonl. "off" desliga o arquivo.
TRACE_FILE=
