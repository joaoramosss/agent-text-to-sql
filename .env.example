# Copie para .env e preencha. O .env nunca é commitado.

# Provedor de LLM: groq | openrouter
LLM_PROVIDER=groq

# Modelo (nome como o provedor espera)
#   groq:       openai/gpt-oss-120b | qwen/qwen3.8-27b | openai/gpt-oss-20b
#   openrouter: ex. openai/gpt-oss-120b:free
LLM_MODEL=openai/gpt-oss-120b

# Chaves — crie em https://console.groq.com/keys e https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
